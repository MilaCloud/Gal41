<Page x:Class="Галиханова41Размер.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Галиханова41Размер"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <TextBlock Text="Логин"  VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="30"  Margin="10"  Grid.Row="0"></TextBlock>
        <TextBlock Text="Пароль" HorizontalAlignment="Right"  FontSize="30" Margin="10" Grid.Row="1"></TextBlock>

        <TextBox Name="LoginTB" Grid.Column="1" Width="300" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="20" Margin="10"></TextBox>
        <TextBox Name="PassTB" Grid.Column="1" Grid.Row="1" Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Margin="10"></TextBox>

        <StackPanel Name="captchaPanel" Visibility="Collapsed" VerticalAlignment="Center" Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
            <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
            <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"></TextBlock>
            <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
            <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"></TextBlock>
            <TextBox Name ="captchaInputTB" Margin="20,0,0,0" Width="100"  FontSize="20" Height="30"></TextBox>
        </StackPanel>
        

        <Button  Name="GuestLoginBtn" Click="GuestLoginBtn_Click" Grid.Row="2" Content="Войти как гость"></Button>
        <Button  Name="LoginBtn" Click="LoginBtn_Click" Grid.Column="1" Grid.Row="2" Content="Войти"></Button>

        
        
    </Grid>
</Page>
